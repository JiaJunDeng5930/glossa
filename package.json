{
  "name": "glossa",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "e2e:bootstrap": "playwright install chromium",
    "preview:ui": "npm run build && node scripts/serve-ui-preview.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "wordlists:check": "node scripts/known-wordlists.mjs --check",
    "dictionary:check": "node scripts/ecdict.mjs --check",
    "test": "vitest run",
    "test:state-model": "vitest run tests/state-model",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run wordlists:check && npm run test && npm run build && npm run test:e2e",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.0.315",
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "p-limit": "^7.3.0"
  }
}
